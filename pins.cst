// SİSTEM SAATİ VE BUTON
IO_LOC "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "btn" 88;
IO_PORT "btn" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// I2C SENSÖR PİNLERİ (Senin istediğin 71 ve 72)
IO_LOC "sda" 72;
IO_PORT "sda" IO_TYPE=LVCMOS33 PULL_MODE=UP; // I2C için Pull-Up Şart!

IO_LOC "scl" 71;
IO_PORT "scl" IO_TYPE=LVCMOS33 PULL_MODE=UP; // I2C için Pull-Up Şart!

// TANG NANO 20K DAHİLİ LED'LERİ
IO_LOC "led[5]" 20;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "led[4]" 19;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "led[3]" 18;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "led[2]" 17;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "led[1]" 16;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "led[0]" 15;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP;